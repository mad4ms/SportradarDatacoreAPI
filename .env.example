# Sportradar DataCore API — Beispielkonfiguration
#
# Kopieren und mit echten Werten befüllen:
#   cp .env.example .env
#
# .env ist in .gitignore und darf niemals eingecheckt werden.
# Diese Datei enthält ausschließlich Platzhalter.

# --- REST API (Pflicht) ------------------------------------------------------
# Basis-URL der DataCore REST API.
BASE_URL=https://api.dc.connect.sportradar.com/v1

# OAuth2-Token-Endpunkt. Wird für den Client-Credentials-Flow verwendet.
AUTH_URL=https://token.connect.sportradar.com/v1/oauth2/rest/token

# OAuth2 Client Credentials aus dem Sportradar-Kundenportal.
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# Organisation, auf die sich die Anfragen beziehen.
CLIENT_ORGANIZATION_ID=your-organization-id

# Optional: nur zur Lesbarkeit in Logs/Reports, wird nicht an die API gesendet.
CLIENT_ORGANIZATION_NAME=your-organization-name

# --- Streaming API (optional, benötigt das Extra "stream") -------------------
# Installation: uv sync --extra stream   bzw.   pip install -e ".[stream]"
#
# Basis-URL für die Stream-Access-Endpunkte (/stream/fixture/access usw.).
# Bleibt der Wert leer, wird er aus AUTH_URL abgeleitet, indem das Suffix
# "/oauth2/rest/token" entfernt wird.
STREAM_TOKEN_BASE_URL=https://token.connect.sportradar.com/v1

# Fixture-ID für die Live-Streaming-Tests. Ohne diesen Wert wird
# test_fixture_stream_access_live übersprungen.
STREAM_FIXTURE_ID=

# --- Tests (optional) --------------------------------------------------------
# Auf "1" setzen, um das Schreiben der JSON-Testartefakte nach log/ zu
# unterdrücken.
SRD_SKIP_TEST_LOGS=1
